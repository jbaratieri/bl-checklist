{
  "cleanUrls": true,
  "routes": [
    {
      "src": "/bonus-plantilhas/(.*\\.pdf)$",
      "dest": "/api/bonus-plantilhas-deny"
    },
    { "handle": "filesystem" }
  ],
  "headers": [
    {
      "source": "/bonus-plantilhas(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/(boasvindas|admin).html",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive, nosnippet" },
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, max-age=0" }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/lp",
      "destination": "/metodo-baratieri-app-luthieria",
      "permanent": true
    },
    {
      "source": "/parceiros",
      "destination": "/parceiros-afiliados-metodo-baratieri",
      "permanent": true
    }
  ]
}
